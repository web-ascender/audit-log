<%= render "audit_log/shared/nav" %>
<h1>One action</h1>
<p class="mono small"><%= @request_id %></p>

<% if @cause %>
  <p class="note">Caused by
    <%= link_to @cause.summary, request_path(@cause.request_id) %>
    (<%= @cause.actor_display %>, <%= audit_time(@cause.occurred_at) %>)
  </p>
<% end %>

<section>
  <h2>Narrative</h2>
  <%= render "audit_log/shared/event_rows", events: @events %>
</section>

<section>
  <h2><%= pluralize(@changes.size, "row change") %></h2>
  <p class="note">
    Everything the database recorded under this one correlation id. A form submit that saves a
    parent and its nested children appears here as one action with N children — not N unrelated
    version rows.
  </p>
  <%# A narrowed query must never be mistaken for a complete one. The bound buys
      partition pruning (see AuditLog::RequestDrillDown); saying so, and offering
      the unbounded query, is what keeps that an optimization rather than a quiet
      omission. %>
  <p class="note small">
    Searched <strong><%= @drill_down.scope_description %></strong>.
    <% if @drill_down.bounded? %>
      <%= link_to "Search all retained history", request_path(@request_id, full: 1) %>
      — slower, and scans every partition.
    <% end %>
  </p>
  <%= render "audit_log/shared/change_rows", changes: @changes %>
</section>

<% if @caused.any? %>
  <section>
    <h2>Caused these</h2>
    <p class="note">Background jobs enqueued by this action. Each got a fresh
       <code>request_id</code> and recorded this one as its cause.</p>
    <%= render "audit_log/shared/event_rows", events: @caused %>
  </section>
<% end %>
