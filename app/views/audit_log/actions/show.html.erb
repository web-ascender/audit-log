<%= render "audit_log/shared/nav" %>
<h1 class="mono"><%= @action %></h1>
<% if @entry&.description %><p class="note"><%= @entry.description %></p><% end %>
<%= render "audit_log/shared/date_filter", url: action_path(@action) %>

<section>
  <h2>Who triggered it</h2>
  <table class="grid compact">
    <% @by_actor.each do |(type, id, label), count| %>
      <tr>
        <td><%= link_to (label.presence || "#{type} ##{id}"),
                  actor_path(id, audit_range_params.merge(actor_type: type)) %></td>
        <td class="num"><%= number_with_delimiter count %></td>
      </tr>
    <% end %>
    <% if @by_actor.empty? %><tr><td class="empty">No events in this range.</td></tr><% end %>
  </table>
</section>

<section>
  <h2>Events</h2>
  <%= render "audit_log/shared/event_rows", events: @events %>
  <%= render "audit_log/shared/pagination", pagy: @pagy, rows: @events %>
</section>
