# frozen_string_literal: true

# Everything the audit log needs to know about THIS application.
#
# The library names no application constant -- no User, no ApplicationRecord, no
# authentication gem, no model. Every coupling point is a lambda or a string here.
# If you find yourself wanting the library to know something about this app, add a
# config attribute; do not reach for the constant.
#
# Full reference: the gem's README.md. Reasoning: its DESIGN.md.
AuditLog.configure do |config|
  # --------------------------------------------------------------------- actors
  # Resolves the acting user from a controller. The default works with Devise,
  # the Rails authentication generator, and anything else exposing `current_user`
  # in controller scope.
  config.actor_resolver = ->(controller) { controller.try(:current_user) }

  # The label SNAPSHOTTED onto every audit row this actor touches, computed once
  # per request. A snapshot rather than a live join on purpose: if the UI joined
  # to `users` to render a name, renaming or deleting a user would retroactively
  # change what the audit log says happened, and auditors read that as tampering.
  #
  # `to_label` on your user model is the intended hook. The default falls back to
  # name/email/"Class #id" so an ApiKey or a Machine actor still reads sensibly.
  # config.actor_label_resolver = ->(actor) { actor.to_label }

  # Populates the actor picker on the audit screens. Sourced from your users
  # table, never from the audit log: an auditor searching "Jane Doe" wants to
  # find her whether or not she has activity in the current window.
  #
  # Returns [] by default, which makes the picker an empty dropdown.
  # config.actor_picker = lambda do |query|
  #   scope = User.order(:name)
  #   scope = scope.where("name ILIKE :q OR email ILIKE :q", q: "%#{query}%") if query.present?
  #   scope.limit(50)
  # end

  # -------------------------------------------------------------- authorization
  # THE AUDIT SCREENS ARE A PRIVILEGED SURFACE AND THIS DEFAULTS TO A NO-OP.
  # Anyone who can reach the mount point can read every change every user ever
  # made. Replace this before deploying.
  # ->(type, id) { } -> a path/URL string, or nil.
  #
  # Where THIS app shows the record a (type, id) names. Used by an activity
  # history you render on your own pages (`rails generate audit_log:views:activity`) --
  # the "also touched" list and the actor byline. Nothing in the gem's own
  # screens calls it; the auditor UI links into the auditor UI.
  #
  # nil is the default and a legitimate answer. This gem will not guess
  # `product_path` from "Product": a wrong link on an audit screen is worse than
  # no link, and it fails at RENDER time on a page an auditor is reading. Return
  # nil for a type you have no page for, and for a record this viewer may not
  # open.
  #
  #   config.record_url = lambda do |type, id|
  #     routes = Rails.application.routes.url_helpers
  #     case type
  #     when "Order"   then routes.order_path(id)
  #     when "Product" then routes.product_path(id)
  #     end
  #   end

  config.authorize = lambda do |controller|
    unless controller.current_user&.respond_to?(:auditor?) && controller.current_user.auditor?
      raise ActionController::RoutingError, "Not authorized to view the audit log"
    end
  end

  # Inherits your layout, authentication and helpers. Resolved lazily, by name.
  # config.parent_controller = "ApplicationController"

  # ------------------------------------------------------------------- coverage
  # Tables that legitimately have no audit trigger, each WITH A WRITTEN REASON.
  # Anything not audited and not listed here fails the coverage spec, which is
  # the forcing function that keeps "opt-in" from degrading into "forgotten".
  #
  # Rails' own tables are pre-listed. Note what does NOT need listing: tables in
  # a database this app does not audit -- a queue or cache database attached
  # through connects_to is never seen by the primary connection.
  config.unaudited_tables.merge!(
    # "sessions" => "session store; churn with no compliance value",
    #
    # Ahoy, if this app tracks analytics. Visits and events are views rather
    # than changes.
    # "ahoy_events" => "analytics event stream; high churn, no compliance value",
    # "ahoy_visits" => "analytics visit log; high churn, no compliance value",
    #
    # Active Storage. Uncomment the ones this app genuinely has no question
    # about -- and think about `active_storage_attachments` before you do: it
    # records who attached which file to which record, which is a real auditor
    # question in a document-heavy app.
    # "active_storage_blobs"           => "uploaded file metadata; no user decision recorded",
    # "active_storage_attachments"     => "attachment join rows; no compliance value in this app",
    # "active_storage_variant_records" => "derived image variants; no user decision recorded",
    #
    # PaperTrail
    # "versions" => "PaperTrail's own log; auditing an audit log recurses",
    #
    # PostGIS
    # "us_lex"          => "US Lex tables; external reference data",
    # "us_gaz"          => "US Gazetteer tables; external reference data",
    # "us_rules"        => "US Rules tables; external reference data",
    # "spatial_ref_sys" => "Spatial reference system table; external reference data",
  )

  # LEAVE THIS ALONE unless this app has more than one database. The default is
  # right for nearly every app, including one whose database.yml has no
  # `primary:` key at all -- Rails names a flat, single-database config
  # "primary", so `%w[primary]` already matches it.
  #
  # These are CONNECTION names as Rails names them (`primary`, `queue`), NOT
  # database names: the value is compared against
  # `connection.pool.db_config.name`. Putting a database name here -- the
  # tempting mistake -- matches no connection, and the failure is silent. Every
  # trigger still fires and every row is still written; they simply all arrive
  # with a NULL actor and NULL request_id. The engine now refuses to boot on a
  # value that matches nothing, which is how you would find out.
  #
  # What it actually decides is who PAYS for the correlation round trip, not what
  # is audited: a connection left out is still fully audited. Set it only for a
  # multi-database app that audits tables outside the primary connection -- and
  # leave a queue or cache database OUT, so the stamp never fires on a poll.
  # config.correlated_connections = %w[primary]

  # ----------------------------------------------------------------- lifecycle
  # Policy, not implementation -- someone has to own the horizon, and it should be
  # visible where the rest of this app's audit decisions are.
  #
  # Only `rake audit_log:partitions` is safe to schedule. The others take ACCESS
  # EXCLUSIVE on an audit table and belong in a maintenance window.
  # config.retention        = 7.years   # nil disables retirement entirely
  # config.rollup_after     = 2.years   # consolidate closed years; nil disables

  # ------------------------------------------------------------------- the rest
  # Classes permitted to call AuditLog.without_logging. Empty means the bypass is
  # unavailable, which is the right default. The bypass logs itself first.
  # config.bypass_allowlist = %w[CatalogImportJob]

  # Rows per page on the audit screens. Keyset-paginated, so there is no OFFSET
  # to grow and no COUNT to compute -- this is a rendering choice, not a cost one.
  # config.page_size = 50

  # Columns never copied into a diff, on any table. Per-table additions belong in
  # the migration's attach_audit_trigger; this is the floor everywhere.
  # config.default_excluded_columns += %w[api_token]

  # Captions association ids in a diff with the record they point at --
  # "product_id  (not set) -> Grommet 10mm (id: 51)". OPT-IN per model: define
  # `to_audit_label` and it appears; define nothing and the bare id renders
  # exactly as before. The id is never replaced.
  # config.record_label_resolver = ->(type, ids) { ... }   # nil disables entirely
  # config.association_targets   = { "LineItem" => { "legacy_ref" => "Product" } }
end

# ---------------------------------------------------------------------------
# THE REGISTRY -- the finite, reviewable list of what this system considers an
# auditable action, and the home of each action's human sentence.
#
# Layer 1 records that six rows changed. Only this application can say that those
# six rows constituted "submitting an order". That sentence lives here, so the
# list of things this app considers worth narrating is reviewable in one place.
#
# An AuditLog.notify with no entry here is a SILENT NO-OP as far as audit_events
# is concerned: the event still reaches any observability subscriber and never
# becomes an audit row. That is how analytics stays out of the audit tables, and
# it is the first thing to check when an action does not appear on the screens.
#
# Skipping an entry is legal. The change is still fully audited at the record
# level by layer 1; it simply shows up in `rake audit_log:reconcile`, which is
# how this list keeps filling in.
# ---------------------------------------------------------------------------
Rails.application.config.to_prepare do
  AuditLog::Registry.clear!

  # A registry entry takes five options:
  #
  #   summary:      REQUIRED. lambda -> String.
  #                 Describes a SPECIFIC OCCURRENCE. Usually a noun, a verb and
  #                 some kind of human-friendly record descriptor.
  #                 e.g. ->(p) { "Submitted Order #{p[:number]}" }
  #                 Stored on the row (audit_events.summary), rendered at emit
  #                 and frozen -- editing the lambda changes what future rows
  #                 say, never what past ones said.
  #
  #   requires:     Optional, recommended. An array of payload keys.
  #                 e.g. requires: %i[order_id reference customer_name]
  #                 Raises at emit time when one is missing, so the summary
  #                 above cannot render a sentence with a hole in it. That
  #                 matters here more than most guards: a summary is frozen
  #                 when it is written, so a holed one can never be repaired.
  #                 It makes the call site's keys and this entry's p[...] reads
  #                 agree, so a typo on EITHER side fails against it.
  #                 Checked with `key?` and not the value, so a deliberate
  #                 `reason: nil` passes where a forgotten `reason:` does not.
  #                 Extra keys always pass, and are still stored.
  #                 It runs inside the transaction that emitted the event, so a
  #                 violation rolls that write back rather than recording it
  #                 under a sentence that cannot be rendered.
  #                 Declare what the entry cannot RENDER without, not every key
  #                 it reads -- a key the summary already treats as optional
  #                 does not belong here. Omitting the line entirely means no
  #                 check, which is the escape valve for a rare branch you would
  #                 rather not have raise in production.
  #
  #   subject:      Optional, recommended. lambda -> [type, id].
  #                 Tracks the model type and id each occurrence was about.
  #                 e.g. ->(p) { ["Order", p[:order_id]] }
  #                 Stored as the indexed subject_type / subject_id columns.
  #                 Set it whenever the summary could carry personal data, or a
  #                 later erasure request will not reach these rows.
  #
  #   description:  Optional, recommended. A plain String, not a lambda.
  #                 A descriptive label for the ACTION ITSELF rather than any
  #                 one occurrence -- so it takes no payload.
  #                 e.g. "Submitted an Order"  (for "order.submitted")
  #                 Not stored on any row; it lives only in this file, and is
  #                 shown at the top of /audit/actions/<name>.
  #
  #   dimensions:   Optional. An array of payload keys, lifted onto the event's
  #                 own indexed `dimensions` column so the log can be filtered
  #                 by your associations rather than only by record.
  #                 e.g. dimensions: %i[customer_id]
  #                 Opt-in per entry, and it needs a migration and a little
  #                 config besides -- read "Dimensions" in the gem's README
  #                 before declaring one.
  #
  # ONE NAMING RULE, WORTH FOLLOWING FROM THE FIRST ENTRY: every id key in a
  # payload NAMES ITS TYPE -- `order_id:`, never a bare `id:` -- including on an
  # action whose subject IS that record, and `subject:` reads the prefixed key.
  # It costs six characters and closes three holes, two of them silent:
  #
  #   * A bare `id` cannot be declared as a dimension. `dimensions: %i[id]`
  #     records {"id": "4821"}, which no `order_id` filter will ever match, so
  #     the record's own events drop off its own facet feed while a record
  #     timeline still shows them -- two screens disagreeing about one history.
  #   * `metadata` renders on the action screen as the evidence behind the
  #     sentence, and `id: 4821` beside `number: "SO-4821"` does not say which
  #     of the two numbers the log recorded.
  #   * A payload is frozen at emit time, so neither of those is repairable
  #     afterwards. Renaming the key changes what future rows carry, never what
  #     past ones do.
  #
  # Put the key in `requires:` too and the rename is loud rather than silent: a
  # call site you missed raises inside its own transaction instead of quietly
  # storing a NULL subject.
  #
  # AuditLog::Registry.register "order.submitted",
  #   requires: %i[order_id reference customer_name],
  #   description: "An order was submitted for fulfillment.",
  #   subject: ->(p) { ["Order", p[:order_id]] },
  #   summary: ->(p) { "Submitted order #{p[:reference]} for #{p[:customer_name]}" }
  #
  # Then, inside the transaction that does the work:
  #
  #   AuditLog.notify("order.submitted",
  #     order_id: id, reference: reference, customer_name: customer.name)
  #
  # You never pass the actor, IP, source, timestamp or request_id -- all five come
  # from AuditLog::Current, which ControllerContext/JobContext populated. The
  # payload is only the domain detail, and it is stored on the event so a screen
  # can render the total AFTER the order has been deleted.

  # -------------------------------------------------------------------------
  # THE LIBRARY'S OWN ACTIONS. Leave these registered.
  #
  # Everything above is yours. These five are emitted by audit_log itself, and
  # they are the actions that narrate the moments the audit log stops being a
  # plain record of your application: a bypass, an erasure, a pause in capture.
  #
  # AN UNREGISTERED ACTION IS A SILENT NO-OP -- `EventSubscriber` is
  # `Registry[name] or return` -- so deleting one of these does not disable a
  # feature, it makes that feature stop narrating itself while going on working.
  # `AuditLog::Bypass` promises "the bypass logs itself"; without the first entry
  # below, it does not, and the only evidence a bulk load ran unaudited is the
  # hole it left. Edit the wording freely; do not delete the entries.
  #
  # `AuditLog::Capture` is the exception that raises rather than falling silent,
  # because a deliberate gap in an audit log with nothing accounting for it is
  # the worst outcome this library has.
  # -------------------------------------------------------------------------
  AuditLog::Registry.register "audit.bypass",
    requires: %i[reason],
    description: "Layer 1 was deliberately disabled for a bulk operation.",
    summary: ->(p) { "Audit logging bypassed by #{p[:by] || "System"}: #{p[:reason]}" }

  AuditLog::Registry.register "audit.bypass_completed",
    requires: %i[reason],
    description: "A bypassed bulk operation finished.",
    summary: ->(p) { "Bypass finished in #{p[:duration_ms]}ms: #{p[:reason]}" }

  # The one action that modifies audit rows, so its own row matters most. Note
  # what the summary keeps: what was redacted, from where, by whom and under what
  # authority -- none of which is the redacted data.
  AuditLog::Registry.register "audit.redaction",
    requires: %i[target_type target_id reason],
    description: "Values were redacted from the audit log under an erasure request. " \
                 "The structural record -- which field changed, when, by whom -- is intact.",
    subject: ->(p) { [p[:target_type], p[:target_id]] },
    summary: lambda { |p|
      scope = Array(p[:columns]).presence&.join(", ") || "all recorded values"
      "Redacted #{scope} for #{AuditLog::Identity.for(p[:target_type], p[:target_id])} " \
        "(#{p[:reason]}), by #{p[:redacted_by] || "System"}"
    }

  AuditLog::Registry.register "audit.capture_disabled",
    requires: %i[reason],
    description: "Layer 1 trigger capture was disabled. Field-level diffs stop " \
                 "being recorded from this point until capture is resumed.",
    summary: lambda { |p|
      "Audit capture disabled for #{Array(p[:tables]).size} tables: #{p[:reason]}"
    }

  AuditLog::Registry.register "audit.capture_resumed",
    description: "Layer 1 trigger capture was resumed. The window in between is a " \
                 "gap in the change record, and there is no backfill for it.",
    summary: lambda { |p|
      since = p[:disabled_at].presence
      "Audit capture resumed#{" (disabled since #{since})" if since}"
    }
end
