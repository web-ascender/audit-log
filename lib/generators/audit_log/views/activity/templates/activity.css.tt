/* Styles for the activity feed generated by `rails generate audit_log:views:activity`.
   Plain CSS, no build step, no framework. Every colour reads a CSS custom
   property with a literal fallback, so it renders standalone and picks up your
   design tokens if you happen to define any of --panel, --line, --muted, --ink,
   --accent, --delete or --insert.

   Delete this file and write your own if you use Tailwind or anything else. The
   markup carries semantic class names for exactly that reason. What is worth
   keeping whatever you do:

     .activity.narrated vs .activity.bare -- a sentence YOUR app composed from
       column names must not look like one the registry froze at emit time.
     .fields .old / .new -- the before/after colours. An ABSENCE stays muted:
       "there was nothing here" is not a before-or-after fact, and colouring it
       red reports a field that never had a value as one that lost one.
     .fields is a grid and its <li> is `display: contents`, so every child of an
       <li> is a grid cell. A helper returning two elements for one cell shifts
       every later column -- valid markup, correct values, scrambled page. */

.activity-feed { list-style: none; margin: 0 0 8px; padding: 0 0 0 24px;
  border-left: 1px solid var(--line, #e2e2dc); }
.activity-feed > li { position: relative; }
.activity-feed .activity { background: var(--panel, #fff); border: 1px solid var(--line, #e2e2dc);
  border-radius: 8px; padding: 11px 14px 12px; margin-bottom: 12px; }
.activity-feed .activity::before { content: ""; position: absolute; left: -29px; top: 14px;
  width: 9px; height: 9px; border-radius: 50%; background: var(--panel, #fff);
  border: 2px solid var(--line, #e2e2dc); }
.activity-feed .activity.narrated::before { background: var(--accent, #2f5d50); border-color: var(--accent, #2f5d50); }
.activity-feed .activity.redacted { border-color: #ecd9bd; background: #fdfaf5; }
.activity-feed li.empty { color: var(--muted, #6b6b64); font-style: italic; padding: 10px 0; }

.activity-feed .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px;
  font-size: 12px; color: var(--muted, #6b6b64); margin-bottom: 6px; }
.activity-feed .meta time { font-variant-numeric: tabular-nums; }
.activity-feed .headline { margin: 0 0 3px; font-size: 14.5px; line-height: 1.45; }
.activity-feed .activity.bare .headline { color: var(--muted, #6b6b64); }
.activity-feed .who { margin: 0; font-size: 12px; color: var(--muted, #6b6b64); }
.activity-feed .redaction-note { margin: 8px 0 2px; font-size: 12.5px; }

/* Disclosures. The summary is a control, so it reads as one; the triangle is
   drawn with borders because the "▸" glyph renders as a speck at this size. */
.activity-feed details { margin-top: 7px; font-size: 13px; }
.activity-feed details + details { margin-top: 5px; }
.activity-feed details > summary { display: flex; align-items: center; gap: 6px;
  padding: 3px 7px; margin-left: -7px; border-radius: 5px; width: fit-content;
  list-style: none; user-select: none; }
.activity-feed details > summary::-webkit-details-marker { display: none; }
.activity-feed details > summary::before { content: ""; width: 0; height: 0; flex: none;
  border-left: 5px solid var(--muted, #6b6b64);
  border-top: 4px solid transparent; border-bottom: 4px solid transparent;
  transition: transform .12s ease; }
.activity-feed details[open] > summary::before { transform: rotate(90deg); }
.activity-feed details > summary:hover { background: #f4f4f0; color: var(--ink, #1b1b19); }
.activity-feed details[open] > summary { color: var(--ink, #1b1b19); }
.activity-feed details > *:not(summary) { margin: 5px 0 2px; padding: 8px 10px;
  background: #fbfbf9; border: 1px solid #f0f0ec; border-radius: 6px; }

/* The UL is the grid and each LI is `display: contents`, so all four columns
   size against EVERY row rather than each row sizing alone -- which is what
   keeps the arrows in one line. Every cell must be exactly ONE element; see
   ActivityHelper#activity_value for the bug that rule exists to prevent. */
.activity-feed .fields { list-style: none;
  display: grid; grid-template-columns: minmax(84px, 150px) minmax(0, max-content) 16px minmax(0, 1fr);
  gap: 3px 10px; align-items: baseline; font-size: 12.5px; }
.activity-feed .fields li { display: contents; }
.activity-feed .fname { color: var(--muted, #6b6b64); overflow-wrap: anywhere; }
.activity-feed .arrow { color: var(--muted, #6b6b64); text-align: center; }
.activity-feed .assoc-id { color: var(--muted, #6b6b64); font-size: 11px; }

/* The same before/after colour language table.diff and the auditor timeline use,
   so a value reads identically wherever somebody found it. An ABSENCE is not
   coloured -- `(not set)` and `(cleared)` stay muted, because "this was empty"
   is not a before-or-after fact and colouring it red would report a field that
   never had a value as one that lost one. */
.activity-feed .fields .old { color: var(--delete, #a33a2a); overflow-wrap: anywhere; }
.activity-feed .fields .new { color: var(--insert, #2f6b3f); overflow-wrap: anywhere; }

.activity-feed .record-list { list-style: none; margin: 0; padding: 0; }
.activity-feed .record-list li { display: flex; flex-wrap: wrap; align-items: baseline;
  gap: 6px; padding: 2px 0; border-bottom: 1px solid #f4f4f0; font-size: 12.5px; }
.activity-feed .record-list li:last-child { border-bottom: none; }
.activity-feed .record-list .col-chip { font-size: 11.5px; }

/* THIRD LEVEL: the touched record's own values, one more click down. The row is
   a flex line, so the disclosure claims a whole line of its own rather than
   being squeezed in beside the column chips -- and it is indented under that
   row, WITHOUT the -7px hanging summary the outer two levels use. Left at that
   default the deepest disclosure's triangle hangs further LEFT than the record
   row it belongs to, so the nesting reads inside out. `flex: 1 1` rather than
   `0 0` so the indent shrinks the line instead of overflowing it, which does
   not depend on the host having a border-box reset. */
.activity-feed .record-list details { flex: 1 1 100%; min-width: 0;
  margin: 2px 0 4px 18px; }
.activity-feed .record-list details > summary { margin-left: 0; }
/* And the field list inside it is still the grid, so its LI must stay
   `display: contents`. The .record-list rule above matches these too and has the
   SAME specificity as `.activity-feed .fields li`, so source order alone decided
   it -- every cell re-flowed into one flex line and the grid vanished. Valid
   markup, correct values, scrambled page, exactly as the note at the top of this
   file warns. */
.activity-feed .record-list .fields li { display: contents; }

.activity-feed dl.payload { display: grid; grid-template-columns: minmax(90px, 170px) 1fr;
  gap: 3px 12px; font-size: 12.5px; }
.activity-feed dl.payload dt { color: var(--muted, #6b6b64); }
.activity-feed dl.payload dd { margin: 0; overflow-wrap: anywhere; }

@media (max-width: 700px) {
  .activity-feed .fields { grid-template-columns: 1fr; gap: 1px; }
  .activity-feed .arrow { display: none; }
}
